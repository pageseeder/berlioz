<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE service-config PUBLIC "-//Berlioz//DTD::Services 1.0//EN"
    "https://pageseeder.org/schema/berlioz/services-1.0.dtd">
<service-config version="1.0">

  <services group="default">
    <namespace package="org.pageseeder.berlioz.sample"/>
    <service id="index" method="get">
      <url pattern="/index"/>
      <generator class="org.pageseeder.berlioz.generator.NoContent"/>
    </service>

    <service id="hello" method="get">
      <url pattern="/hello"/>
      <generator class="HelloGenerator"/>
    </service>

    <service id="general-error" method="get">
      <url pattern="/test/error"/>
      <generator class="ErrorGenerator"/>
    </service>

  </services>

  <services group="api">
    <namespace package="org.pageseeder.berlioz.sample.api"/>
    <service id="get-note" method="get">
      <url pattern="/api/note"/>
      <handler class="GetNote"/>
    </service>
    <service id="update-note" method="post">
      <url pattern="/api/note"/>
      <handler class="UpdateNote"/>
    </service>
    <service id="standalone-error" method="get">
      <url pattern="/api/error"/>
      <handler class="org.pageseeder.berlioz.sample.ErrorGenerator"/>
    </service>
  </services>

</service-config>
